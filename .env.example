# ==========================================
# デプロイ設定ファイル (.env)
# ⚠️ セキュリティ上、このファイルは Git (.gitignore) などで必ず除外してください
# ==========================================

# 転送方式: SSHが使えるサーバーなら 'rsync'、FTP/FTPSのみなら 'lftp'
DEPLOY_METHOD=rsync

# サーバー接続情報
SERVER_HOST=your-server-domain.com
SERVER_USER=your_username
SERVER_PASSWORD=your_password  # rsync使用時でSSHキー認証を利用する場合は不要
SERVER_PORT=22                 # SSHなら22や10022など、FTPなら21

# デプロイ元・先のパス設定
LOCAL_DIR=public               # ローカルのデプロイ対象フォルダ (.deploy.sh の引数で上書き可能)
REMOTE_DIR=/var/www/html/public # サーバー側のアップロード先フォルダ（絶対パスかホームディレクトリからの相対パス）
